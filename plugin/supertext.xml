<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_supertext</name>
	<author>Supertext AG</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) Supertext AG</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<authorEmail>support@supertext.com</authorEmail>
	<authorUrl>https://www.supertext.com</authorUrl>
	<version>0.1.0</version>
	<description>PLG_SYSTEM_SUPERTEXT_XML_DESCRIPTION</description>
	<namespace path="src">Supertext\Plugin\System\Supertext</namespace>
	<files>
		<folder plugin="supertext">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>
	<media destination="plg_system_supertext" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>js</folder>
		<folder>css</folder>
	</media>
	<config>
		<fields name="params" addfieldprefix="Supertext\Plugin\System\Supertext\Field">
			<fieldset name="basic">
				<field name="api_key" type="password" label="PLG_SYSTEM_SUPERTEXT_API_KEY" description="PLG_SYSTEM_SUPERTEXT_API_KEY_DESC" filter="raw" autocomplete="off" lock="true" maxlength="1000" />
				<field name="test" type="connection" label="PLG_SYSTEM_SUPERTEXT_TEST_LABEL" />
				<field name="environment" type="list" label="PLG_SYSTEM_SUPERTEXT_ENVIRONMENT" default="live" validate="options">
					<option value="live">PLG_SYSTEM_SUPERTEXT_ENVIRONMENT_LIVE</option>
					<option value="staging">PLG_SYSTEM_SUPERTEXT_ENVIRONMENT_STAGING</option>
					<option value="testing">PLG_SYSTEM_SUPERTEXT_ENVIRONMENT_TESTING</option>
				</field>
				<field name="endpoint" type="url" label="PLG_SYSTEM_SUPERTEXT_ENDPOINT" description="PLG_SYSTEM_SUPERTEXT_ENDPOINT_DESC" filter="url" validate="url" />
				<field name="target_state" type="list" label="PLG_SYSTEM_SUPERTEXT_TARGET_STATE" description="PLG_SYSTEM_SUPERTEXT_TARGET_STATE_DESC" default="0" filter="integer" validate="options">
					<option value="0">JUNPUBLISHED</option>
					<option value="1">JPUBLISHED</option>
				</field>
				<field name="custom_fields" type="radio" label="PLG_SYSTEM_SUPERTEXT_CUSTOM_FIELDS" description="PLG_SYSTEM_SUPERTEXT_CUSTOM_FIELDS_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="languages" label="PLG_SYSTEM_SUPERTEXT_FIELDSET_LANGUAGES" description="PLG_SYSTEM_SUPERTEXT_FIELDSET_LANGUAGES_DESC">
				<field name="languages" type="subform" label="PLG_SYSTEM_SUPERTEXT_LANGUAGES" multiple="true" layout="joomla.form.field.subform.repeatable-table" buttons="add,remove">
					<form>
						<field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL" required="true">
							<option value="">JSELECT</option>
						</field>
						<field name="code" type="text" label="PLG_SYSTEM_SUPERTEXT_LANGUAGE_CODE" hint="fr-CH" filter="string" />
						<field name="politeness" type="list" label="PLG_SYSTEM_SUPERTEXT_POLITENESS" default="default" validate="options">
							<option value="default">PLG_SYSTEM_SUPERTEXT_POLITENESS_DEFAULT</option>
							<option value="more">PLG_SYSTEM_SUPERTEXT_POLITENESS_MORE</option>
							<option value="less">PLG_SYSTEM_SUPERTEXT_POLITENESS_LESS</option>
						</field>
					</form>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="poll_timeout" type="number" label="PLG_SYSTEM_SUPERTEXT_POLL_TIMEOUT" description="PLG_SYSTEM_SUPERTEXT_POLL_TIMEOUT_DESC" default="180" min="10" max="1800" filter="integer" />
				<field name="poll_interval" type="number" label="PLG_SYSTEM_SUPERTEXT_POLL_INTERVAL" default="2" min="1" max="30" filter="integer" />
			</fieldset>
		</fields>
	</config>
</extension>
