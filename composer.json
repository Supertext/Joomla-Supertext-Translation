{
    "name": "supertext/joomla-supertext-translation",
    "description": "Supertext AI translation for Joomla articles",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Supertext\\Plugin\\System\\Supertext\\": "plugin/src/",
            "Supertext\\Plugin\\System\\Supertext\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "./build.sh"
    },
    "config": {
        "sort-packages": true
    }
}
