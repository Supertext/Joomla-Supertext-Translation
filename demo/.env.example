# Variables of the demo container. On Railway they are service variables; never commit real values.

# PostgreSQL server; the Joomla database (JOOMLA_DB_NAME, default "joomla") is created there if missing.
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
# JOOMLA_DB_NAME=joomla
# JOOMLA_DB_PREFIX=jos_
# JOOMLA_SITE_NAME=Supertext Joomla Demo

# Supertext API key: create an account at https://www.supertext.com/person/en/account/signin,
# then generate the key at https://www.supertext.com/en/integrations/api (requires the Admin role).
# For the stand-in API (tests/docs/stand-in.mjs) use any key and the local endpoint.
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=http://127.0.0.1:8765/v1/
# Optional: another review service for languages with "Translation review" on (Languages tab)
# (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://127.0.0.1:3000/v1/
# Send version information to Supertext (site URL and versions; no content, no key): on by default.
# 0 turns it off, whatever the plugin setting says.
# SUPERTEXT_VERSION_REPORTS=0
# For tests only: where version reports go (e.g. the stand-in), instead of Supertext's Commando Center.
# SUPERTEXT_REPORT_URL=http://127.0.0.1:8765/report

# Accounts created on every start if missing (existing accounts are never changed).
# Joomla's default password rule: at least 12 characters.
# DEMO_ADMIN_EMAIL=you@example.com
# DEMO_ADMIN_PASSWORD=
# The editor account is a Manager (Joomla's Editor group has no backend access).
# DEMO_EDITOR_EMAIL=editor@example.com
# DEMO_EDITOR_PASSWORD=
